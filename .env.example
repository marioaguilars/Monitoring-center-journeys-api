# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
APP_ENV=local
PORT=3000

# ==========================================
# CORS
# Separar múltiples orígenes con coma.
# Si la API será consumida únicamente server-to-server,
# puede dejarse vacío hasta definir consumidores web.
# ==========================================
CORS_ORIGINS=http://localhost:4200

# ==========================================
# RATE LIMIT
# Ventana expresada en milisegundos.
# ==========================================
RATE_LIMIT_WINDOW_MS=60000
IP_RATE_LIMIT_MAX=120
CLIENT_RATE_LIMIT_MAX=60

# Cantidad de proxies confiables delante de Express.
# Local = 0. Producción se define según la infraestructura real.
TRUST_PROXY_HOPS=0

# ==========================================
# API TOKENS
# Vigencia predeterminada de los tokens B2B.
# ==========================================
API_TOKEN_TTL_MONTHS=12

# ==========================================
# BASE DE DATOS - LOCAL
# Usuario de runtime de la API.
# Debe tener únicamente los permisos necesarios.
# ==========================================
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=your-local-runtime-user
LOCAL_DB_PASSWORD=your-local-runtime-password
LOCAL_DB_NAME=qa_monitoring_center

# ==========================================
# BASE DE DATOS - QA
# ==========================================
QA_DB_HOST=your-qa-db-host
QA_DB_PORT=3306
QA_DB_USER=your-qa-runtime-user
QA_DB_PASSWORD=your-qa-runtime-password
QA_DB_NAME=qa_monitoring_center

# ==========================================
# BASE DE DATOS - PRODUCTION
# ==========================================
PRODUCTION_DB_HOST=your-production-db-host
PRODUCTION_DB_PORT=3306
PRODUCTION_DB_USER=your-production-runtime-user
PRODUCTION_DB_PASSWORD=your-production-runtime-password
PRODUCTION_DB_NAME=monitoring_center