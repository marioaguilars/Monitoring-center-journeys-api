{
  "name": "monitoring-center-journeys-api",
  "version": "1.0.0",
  "description": "API B2B para consulta segura de jornadas históricas del Monitoring Center",
  "main": "index.js",
  "scripts": {
    "dev": "npx tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",

    "token:create": "tsx --env-file=.env src/scripts/create-api-client.ts",
    "token:rotate": "tsx --env-file=.env src/scripts/rotate-api-token.ts",
    "token:revoke": "tsx --env-file=.env src/scripts/revoke-api-token.ts"
  },
  "dependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "luxon": "3.7.2",
    "morgan": "1.12.1",
    "mysql2": "3.24.5",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.2",
    "@types/morgan": "1.9.10",
    "@types/node": "22.0.0",
    "cpx2": "9.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimist": "1.2.8",
    "minimatch": "10.2.3",
    "shell-quote": "1.10.0"
  }
}
